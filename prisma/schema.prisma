generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["iam_schema", "employee_schema"]
}

enum Role {
  USER
  ADMIN

  @@map("roles")
  @@schema("iam_schema")
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  role     Role    @default(USER)
  token    Token[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@schema("iam_schema")
}

model Token {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  userAgent String   @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, userAgent])
  @@map("tokens")
  @@schema("iam_schema")
}

model Employee {
  id             String   @id @default(uuid())
  firstname      String
  lastname       String
  patronymic     String
  employmentDate DateTime @map("employment_date")
  birthdate      DateTime
  isFired        Boolean  @default(false) @map("is_fired")
  userId         String   @unique @map("user_id")
  tasks          Task[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employees")
  @@schema("employee_schema")
}

model Task {
  id           String     @id @default(uuid())
  employee     Employee   @relation(fields: [assignedToId], references: [id])
  assignedToId String     @map("assigned_to_id")
  startTime    DateTime   @map("start_time")
  endTime      DateTime   @map("end_time")
  status       TaskStatus @relation(fields: [statusId], references: [id])
  statusId     String     @map("task_status_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tasks")
  @@schema("employee_schema")
}

model TaskStatus {
  id    String @id @default(uuid())
  name  String @unique
  tasks Task[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("task_statuses")
  @@schema("employee_schema")
}
